{
  "name": "@Six6stRINgs/dsh-client-ui-thinking-stats",
  "description": "A lightweight plugin that adds model thinking token statistics to the bottom Dock and the end of each conversation.",
  "version": "1.0.2",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node test/harness.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Six6stRINgs/dsh-client-ui-thinking-stats.git"
  },
  "homepage": "https://github.com/Six6stRINgs/dsh-client-ui-thinking-stats#readme",
  "bugs": {
    "url": "https://github.com/Six6stRINgs/dsh-client-ui-thinking-stats/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "react": "^18.2.0"
  }
}
