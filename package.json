{
  "name": "dsh-thinking-token-stat",
  "description": "Per-turn thinking-token statistics for DeepSeek Harness, folded once by a durable session projection and read by the composer dock.",
  "version": "1.1.0",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node test/projection.mjs && node test/harness.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Six6stRINgs/dsh-thinking-token-stat.git"
  },
  "homepage": "https://github.com/Six6stRINgs/dsh-thinking-token-stat#readme",
  "bugs": {
    "url": "https://github.com/Six6stRINgs/dsh-thinking-token-stat/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "react": "^18.2.0"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README_zh.md",
    "CHANGELOG.md",
    "CHANGELOG_zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "client-plugin",
    "thinking",
    "reasoning-tokens",
    "statistics"
  ]
}
